// Waybar for Hyprland. Styling is in style.css.
// Icons come from Hack Nerd Font.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "wlr/taskbar", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "idle_inhibitor", "pulseaudio", "network", "cpu", "memory", "battery", "custom/keybinds", "custom/power"],

    "custom/launcher": {
        "format": "",
        "tooltip-format": "Apps (SUPER + D)",
        "on-click": "rofi -show drun -show-icons"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    // Open apps on this workspace: click to focus, middle-click to close
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "all-outputs": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#fabd2f'><b>{}</b></span>",
                "weekdays": "<span color='#fe8019'><b>{}</b></span>",
                "today": "<span color='#8ec07c'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Screen stays on",
        "tooltip-format-deactivated": "Screen locks when idle"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": { "headphone": "", "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰖪  offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}",
        "on-click": "nm-connection-editor"
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 5,
        "on-click": "alacritty -e htop"
    },

    "memory": {
        "format": "󰍛  {percentage}%",
        "interval": 10,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    // Hidden on machines without a battery
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/keybinds": {
        "format": "",
        "tooltip-format": "Keybinds (SUPER + /)",
        "on-click": "~/.config/hypr/scripts/keybinds.sh"
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "Power menu (SUPER + SHIFT + E)",
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    }
}
